{
  "name": "plantdoc-ai",
  "version": "3.0.0",
  "private": true,
  "description": "PlantDoc \u2014 grounded plant pathology assistant: hybrid retrieval over a textbook, reranked and cited",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "extract": "node scripts/extract-pdf.mjs",
    "ingest": "node --env-file-if-exists=.env.local scripts/ingest.mjs",
    "index-book": "node --env-file-if-exists=.env.local scripts/index-book.mjs",
    "export-index": "node --env-file-if-exists=.env.local scripts/export-index.mjs",
    "doctor": "node --env-file-if-exists=.env.local scripts/doctor.mjs",
    "extract-figures": "node --env-file-if-exists=.env.local scripts/extract-figures.mjs",
    "caption-figures": "node --env-file-if-exists=.env.local scripts/caption-figures.mjs"
  },
  "dependencies": {
    "@google/genai": "^3.3.0",
    "@pinecone-database/pinecone": "^9.2.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.7.3"
  }
}
