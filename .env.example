# Copy to .env.local for development, and set the same values in Vercel.

# Google AI Studio — free tier. https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Pinecone — free Starter tier. https://app.pinecone.io/
# Used by the app at runtime and by the ingestion scripts.
PINECONE_API_KEY=

# Optional. The defaults below are what `npm run ingest` creates.
# PINECONE_DENSE_INDEX=plantdoc-dense
# PINECONE_SPARSE_INDEX=plantdoc-sparse
# PINECONE_NAMESPACE=default

# Optional. Shown in the UI so the answer says which book it is grounded in.
# NEXT_PUBLIC_BOOK_TITLE=Plant Pathology
# NEXT_PUBLIC_BOOK_SUBTITLE=Agrios, 5th edition
